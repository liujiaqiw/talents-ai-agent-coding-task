@@ -0,0 +1,159 @@
+package com.myorg.webservice.graph.neo4j;
+
+import java.time.Duration;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.neo4j.driver.AuthTokens;
+import org.neo4j.driver.Driver;
+import org.neo4j.driver.EagerResult;
+
+/**
+ * The single Neo4j driver of a {@link Neo4jDatabaseFactory}, shared by all its products, which may use it from
+ * several threads. It is opened by the first product that connects and closed only by the factory.
+ *
+ * <p>The lock of this object guards the state only: it is never held while the server is contacted or between
+ * attempts, so that {@link #close()} never waits for a connect in progress.
+ */
+final class Neo4jConnection {
+
+    private static final System.Logger LOG = System.getLogger(Neo4jConnection.class.getName());
+
+    private final String uri;
+    private final String user;
+    private final String password;
+    private Driver driver;
+    private boolean opening;
+    private boolean closed;
+
+    Neo4jConnection(String uri, String user, String password) {
+        this.uri = uri;
+        this.user = user;
+        this.password = password;
+    }
+
+    /**
+     * Connects to the server; does nothing if already connected. Concurrent calls wait for the one that is
+     * connecting instead of opening a driver of their own, and try themselves only if it fails. Closing the
+     * connection stops the attempts, and a driver that connects after the close is closed again.
+     *
+     * @param attempts number of attempts; the server may still be starting
+     * @param interval pause between attempts
+     * @throws IllegalStateException if the server cannot be reached or the connection is closed
+     */
+    void open(int attempts, Duration interval) {
+        if (!claimOpening()) {
+            return;
+        }
+        Driver candidate = null;
+        try {
+            candidate = org.neo4j.driver.GraphDatabase.driver(uri, AuthTokens.basic(user, password));
+            RuntimeException last = null;
+            boolean connected = false;
+            for (int attempt = 1; attempt <= attempts && !connected; attempt++) {
+                checkNotClosed();
+                try {
+                    candidate.verifyConnectivity();
+                    connected = true;
+                } catch (RuntimeException e) {
+                    last = e;
+                    LOG.log(System.Logger.Level.WARNING, "Failed to connect to Neo4j (attempt {0}): {1}", attempt,
+                            e.getMessage());
+                    pause(interval);
+                }
+            }
+            if (!connected) {
+                throw new IllegalStateException("Cannot connect to Neo4j at " + uri, last);
+            }
+            publish(candidate);
+            candidate = null;
+            LOG.log(System.Logger.Level.INFO, "Connected to Neo4j {0}", uri);
+        } finally {
+            if (candidate != null) {
+                candidate.close();
+            }
+            finishOpening();
+        }
+    }
+
+    /**
+     * Runs a Cypher query on the connected server.
+     *
+     * @throws IllegalStateException if the connection is not open
+     */
+    EagerResult run(String query, Map<String, Object> parameters) {
+        return driver().executableQuery(query).withParameters(parameters).execute();
+    }
+
+    synchronized void checkNotClosed() {
+        if (closed) {
+            throw new IllegalStateException("The Neo4j connection is closed");
+        }
+    }
+
+    synchronized void close() {
+        closed = true;
+        notifyAll();
+        if (driver != null) {
+            driver.close();
+            driver = null;
+        }
+    }
+
+    private synchronized Driver driver() {
+        checkNotClosed();
+        if (driver == null) {
+            throw new IllegalStateException("Not connected to Neo4j; call connect() first");
+        }
+        return driver;
+    }
+
+    /**
+     * Waits until no other thread is connecting.
+     *
+     * @return {@code true} if the caller must connect, {@code false} if the connection is open already
+     */
+    private synchronized boolean claimOpening() {
+        while (true) {
+            checkNotClosed();
+            if (driver != null) {
+                return false;
+            }
+            if (!opening) {
+                opening = true;
+                return true;
+            }
+            try {
+                wait();
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                throw new IllegalStateException("Interrupted while waiting for the Neo4j connection", e);
+            }
+        }
+    }
+
+    /** Keeps the connected driver, unless the connection was closed meanwhile. */
+    private synchronized void publish(Driver connected) {
+        checkNotClosed();
+        driver = connected;
+    }
+
+    private synchronized void finishOpening() {
+        opening = false;
+        notifyAll();
+    }
+
+    /** Waits for the pause between attempts, or less if the connection is closed meanwhile. */
+    private synchronized void pause(Duration interval) {
+        long deadline = System.nanoTime() + interval.toNanos();
+        long remaining = interval.toNanos();
+        while (!closed && remaining > 0) {
+            try {
+                TimeUnit.NANOSECONDS.timedWait(this, remaining);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+            remaining = deadline - System.nanoTime();
+        }
+    }
+}
