@@ -0,0 +1,53 @@
+package com.myorg.webservice.graph.neo4j;
+
+import com.myorg.webservice.graph.GraphStatistics;
+import java.time.Duration;
+import java.util.Map;
+
+/** Neo4j product of {@link GraphStatistics}, over the nodes and relationships of {@link Neo4jDatabase}. */
+public class Neo4jStatistics implements GraphStatistics {
+
+    private final Neo4jConnection connection;
+    private volatile boolean closed;
+
+    Neo4jStatistics(Neo4jConnection connection) {
+        this.connection = connection;
+    }
+
+    @Override
+    public void connect() {
+        checkNotClosed();
+        connection.open(30, Duration.ofSeconds(2));
+    }
+
+    @Override
+    public long vertexCount() {
+        return count("MATCH (v:Vertex) RETURN count(v) AS n", Map.of());
+    }
+
+    @Override
+    public long edgeCount() {
+        return count("MATCH (:Vertex)-[e:EDGE]->(:Vertex) RETURN count(e) AS n", Map.of());
+    }
+
+    @Override
+    public long outDegree(String id) {
+        return count("MATCH (v:Vertex {vertexId: $id})-[e:EDGE]->() RETURN count(e) AS n", Map.of("id", id));
+    }
+
+    @Override
+    public void close() {
+        closed = true;
+    }
+
+    private long count(String query, Map<String, Object> parameters) {
+        checkNotClosed();
+        return connection.run(query, parameters).records().get(0).get("n").asLong();
+    }
+
+    private void checkNotClosed() {
+        if (closed) {
+            throw new IllegalStateException("These Neo4j statistics are closed");
+        }
+    }
+}
