+package com.myorg.webservice.graph.janusgraph;
+
+import com.myorg.webservice.graph.GraphStatistics;
+import java.time.Duration;
+import org.apache.tinkerpop.gremlin.process.traversal.dsl.graph.GraphTraversalSource;
+
+/** JanusGraph product of {@link GraphStatistics}, over the vertices and edges of {@link JanusGraphDatabase}. */
+public class JanusGraphStatistics implements GraphStatistics {
+
+    private final JanusGraphConnection connection;
+    private volatile boolean closed;
+
+    JanusGraphStatistics(JanusGraphConnection connection) {
+        this.connection = connection;
+    }
+
+    @Override
+    public void connect() {
+        checkNotClosed();
+        connection.open(30, Duration.ofSeconds(2));
+    }
+
+    @Override
+    public long vertexCount() {
+        return g().V().hasLabel(JanusGraphDatabase.VERTEX).count().next();
+    }
+
+    @Override
+    public long edgeCount() {
+        return g().E().hasLabel(JanusGraphDatabase.EDGE).count().next();
+    }
+
+    @Override
+    public long outDegree(String id) {
+        return g().V().has(JanusGraphDatabase.VERTEX, JanusGraphDatabase.VERTEX_ID, id)
+                .outE(JanusGraphDatabase.EDGE).count().next();
+    }
+
+    @Override
+    public void close() {
+        closed = true;
+    }
+
+    private GraphTraversalSource g() {
+        checkNotClosed();
+        return connection.g();
+    }
+
+    private void checkNotClosed() {
+        if (closed) {
+            throw new IllegalStateException("These JanusGraph statistics are closed");
+        }
+    }
+}
