@@ -0,0 +1,174 @@
+package com.myorg.webservice.graph.janusgraph;
+
+import static org.apache.tinkerpop.gremlin.process.traversal.AnonymousTraversalSource.traversal;
+
+import java.net.URI;
+import java.time.Duration;
+import java.util.concurrent.TimeUnit;
+import org.apache.tinkerpop.gremlin.driver.Cluster;
+import org.apache.tinkerpop.gremlin.driver.remote.DriverRemoteConnection;
+import org.apache.tinkerpop.gremlin.process.traversal.dsl.graph.GraphTraversalSource;
+
+/**
+ * The single Gremlin driver connection ({@link Cluster} and its traversal source) of a
+ * {@link JanusGraphDatabaseFactory}, shared by all its products, which may use it from several threads. It is opened
+ * by the first product that connects and closed only by the factory.
+ *
+ * <p>The lock of this object guards the state only: it is never held while the server is contacted or between
+ * attempts, so that {@link #close()} never waits for a connect in progress.
+ */
+final class JanusGraphConnection {
+
+    private static final System.Logger LOG = System.getLogger(JanusGraphConnection.class.getName());
+
+    private final String url;
+    private Cluster cluster;
+    private GraphTraversalSource g;
+    private boolean opening;
+    private boolean closed;
+
+    JanusGraphConnection(String url) {
+        this.url = url;
+    }
+
+    /**
+     * Connects to the Gremlin server; does nothing if already connected. Concurrent calls wait for the one that is
+     * connecting instead of opening a driver of their own, and try themselves only if it fails. Closing the
+     * connection stops the attempts, and a driver that connects after the close is closed again.
+     *
+     * @param attempts number of attempts; the server may still be starting
+     * @param interval pause between attempts
+     * @throws IllegalStateException if the server cannot be reached or the connection is closed
+     */
+    void open(int attempts, Duration interval) {
+        if (!claimOpening()) {
+            return;
+        }
+        Cluster candidate = null;
+        GraphTraversalSource source = null;
+        try {
+            URI uri = URI.create(url);
+            candidate = Cluster.build(uri.getHost())
+                    .port(uri.getPort() > 0 ? uri.getPort() : 8182)
+                    .path(uri.getPath() == null || uri.getPath().isEmpty() ? "/gremlin" : uri.getPath())
+                    .enableSsl("wss".equalsIgnoreCase(uri.getScheme()))
+                    .create();
+            source = traversal().withRemote(DriverRemoteConnection.using(candidate, "g"));
+            RuntimeException last = null;
+            boolean connected = false;
+            for (int attempt = 1; attempt <= attempts && !connected; attempt++) {
+                checkNotClosed();
+                try {
+                    source.inject(1).next();
+                    connected = true;
+                } catch (RuntimeException e) {
+                    last = e;
+                    LOG.log(System.Logger.Level.WARNING, "Failed to connect to JanusGraph (attempt {0}): {1}", attempt,
+                            e.getMessage());
+                    pause(interval);
+                }
+            }
+            if (!connected) {
+                throw new IllegalStateException("Cannot connect to JanusGraph at " + url, last);
+            }
+            publish(candidate, source);
+            candidate = null;
+            source = null;
+            LOG.log(System.Logger.Level.INFO, "Connected to JanusGraph {0}", url);
+        } finally {
+            close(source, candidate);
+            finishOpening();
+        }
+    }
+
+    /**
+     * The traversal source of the connected server.
+     *
+     * @throws IllegalStateException if the connection is not open
+     */
+    synchronized GraphTraversalSource g() {
+        checkNotClosed();
+        if (g == null) {
+            throw new IllegalStateException("Not connected to JanusGraph; call connect() first");
+        }
+        return g;
+    }
+
+    synchronized void checkNotClosed() {
+        if (closed) {
+            throw new IllegalStateException("The JanusGraph connection is closed");
+        }
+    }
+
+    synchronized void close() {
+        closed = true;
+        notifyAll();
+        close(g, cluster);
+        g = null;
+        cluster = null;
+    }
+
+    /**
+     * Waits until no other thread is connecting.
+     *
+     * @return {@code true} if the caller must connect, {@code false} if the connection is open already
+     */
+    private synchronized boolean claimOpening() {
+        while (true) {
+            checkNotClosed();
+            if (g != null) {
+                return false;
+            }
+            if (!opening) {
+                opening = true;
+                return true;
+            }
+            try {
+                wait();
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                throw new IllegalStateException("Interrupted while waiting for the JanusGraph connection", e);
+            }
+        }
+    }
+
+    /** Keeps the connected driver, unless the connection was closed meanwhile. */
+    private synchronized void publish(Cluster connectedCluster, GraphTraversalSource connectedSource) {
+        checkNotClosed();
+        cluster = connectedCluster;
+        g = connectedSource;
+    }
+
+    private synchronized void finishOpening() {
+        opening = false;
+        notifyAll();
+    }
+
+    /** Waits for the pause between attempts, or less if the connection is closed meanwhile. */
+    private synchronized void pause(Duration interval) {
+        long deadline = System.nanoTime() + interval.toNanos();
+        long remaining = interval.toNanos();
+        while (!closed && remaining > 0) {
+            try {
+                TimeUnit.NANOSECONDS.timedWait(this, remaining);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+            remaining = deadline - System.nanoTime();
+        }
+    }
+
+    private static void close(GraphTraversalSource source, Cluster connection) {
+        if (source != null) {
+            try {
+                source.close();
+            } catch (Exception e) {
+                LOG.log(System.Logger.Level.WARNING, "Failed to close the JanusGraph traversal source", e);
+            }
+        }
+        if (connection != null) {
+            connection.close();
+        }
+    }
+}
