@@ -0,0 +1,38 @@
+package com.myorg.webservice.graph.arango;
+
+import com.myorg.webservice.graph.GraphDatabase;
+import com.myorg.webservice.graph.GraphDatabaseFactory;
+import com.myorg.webservice.graph.GraphStatistics;
+
+/** Concrete factory of the ArangoDB family. */
+public class ArangoDatabaseFactory implements GraphDatabaseFactory {
+
+    private final ArangoConnection connection;
+
+    /**
+     * @param url      server URL, e.g. {@code http://localhost:8529}
+     * @param user     user name
+     * @param password password
+     * @param database name of the database, created if it is missing
+     */
+    public ArangoDatabaseFactory(String url, String user, String password, String database) {
+        this.connection = new ArangoConnection(url, user, password, database);
+    }
+
+    @Override
+    public GraphDatabase createDatabase() {
+        connection.checkNotClosed();
+        return new ArangoDatabase(connection);
+    }
+
+    @Override
+    public GraphStatistics createStatistics() {
+        connection.checkNotClosed();
+        return new ArangoStatistics(connection);
+    }
+
+    @Override
+    public void close() {
+        connection.close();
+    }
+}
