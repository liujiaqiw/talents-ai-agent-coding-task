+package com.myorg.webservice.graph.neo4j;
+
+import com.myorg.webservice.graph.GraphDatabase;
+import com.myorg.webservice.graph.GraphDatabaseFactory;
+import com.myorg.webservice.graph.GraphStatistics;
+
+/** Concrete factory of the Neo4j family. */
+public class Neo4jDatabaseFactory implements GraphDatabaseFactory {
+
+    private final Neo4jConnection connection;
+
+    /**
+     * @param uri      Bolt URI, e.g. {@code bolt://localhost:7687}
+     * @param user     user name
+     * @param password password
+     */
+    public Neo4jDatabaseFactory(String uri, String user, String password) {
+        this.connection = new Neo4jConnection(uri, user, password);
+    }
+
+    @Override
+    public GraphDatabase createDatabase() {
+        connection.checkNotClosed();
+        return new Neo4jDatabase(connection);
+    }
+
+    @Override
+    public GraphStatistics createStatistics() {
+        connection.checkNotClosed();
+        return new Neo4jStatistics(connection);
+    }
+
+    @Override
+    public void close() {
+        connection.close();
+    }
+}
