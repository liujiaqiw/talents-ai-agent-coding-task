+package com.myorg.webservice.graph;
+
+/**
+ * Read-only statistics over the graph stored by the {@link GraphDatabase} of the same factory, for monitoring.
+ *
+ * <p>One of the abstract products of the {@link GraphDatabaseFactory}; it uses the connection of the factory that
+ * created it. Once the product or its factory is closed, every operation except {@link #close()} throws
+ * {@link IllegalStateException}.
+ */
+public interface GraphStatistics extends AutoCloseable {
+
+    /**
+     * Opens the connection of the factory, retrying while the database is not ready yet; does nothing if it is
+     * already open.
+     */
+    void connect();
+
+    /** Number of vertices. */
+    long vertexCount();
+
+    /** Number of edges. */
+    long edgeCount();
+
+    /**
+     * Number of edges leaving a vertex.
+     *
+     * @param id vertex ID
+     * @return the number of outbound edges, or 0 if there is no such vertex
+     */
+    long outDegree(String id);
+
+    /** Releases this product only; the connection of the factory stays open for its other products. */
+    @Override
+    void close();
+}
