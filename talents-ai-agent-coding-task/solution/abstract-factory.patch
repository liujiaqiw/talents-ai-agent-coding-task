diff --git a/src/main/java/com/myorg/webservice/graph/GraphDatabaseFactory.java b/src/main/java/com/myorg/webservice/graph/GraphDatabaseFactory.java
new file mode 100644
index 0000000..81506c2
--- /dev/null
+++ b/src/main/java/com/myorg/webservice/graph/GraphDatabaseFactory.java
@@ -0,0 +1,32 @@
+package com.myorg.webservice.graph;
+
+/**
+ * Abstract factory of the graph database layer: creates the products of one database family, which always match each
+ * other.
+ *
+ * <p>Each database is a family in its own subpackage with its concrete products and its concrete factory, which takes
+ * only the connection parameters of its own database. A factory holds exactly one driver connection, opened by the
+ * first {@code connect()} of one of its products and shared by all of them; closing the factory closes it.
+ *
+ * <p><b>To add a database</b>, add a subpackage with its products and factory; no existing class changes.
+ */
+public interface GraphDatabaseFactory extends AutoCloseable {
+
+    /**
+     * Creates a new graph database of this family; it does not contact the database.
+     *
+     * @throws IllegalStateException if this factory is closed
+     */
+    GraphDatabase createDatabase();
+
+    /**
+     * Creates new statistics of this family; it does not contact the database.
+     *
+     * @throws IllegalStateException if this factory is closed
+     */
+    GraphStatistics createStatistics();
+
+    /** Closes the connection shared by the products of this factory; idempotent. */
+    @Override
+    void close();
+}
