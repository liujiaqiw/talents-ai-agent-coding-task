@@ -0,0 +1,60 @@
+package com.myorg.webservice.graph.arango;
+
+import com.arangodb.ArangoCursor;
+import com.myorg.webservice.graph.GraphStatistics;
+import java.io.IOException;
+import java.time.Duration;
+import java.util.Map;
+
+/** ArangoDB product of {@link GraphStatistics}, over the collections of {@link ArangoDatabase}. */
+public class ArangoStatistics implements GraphStatistics {
+
+    private final ArangoConnection connection;
+    private volatile boolean closed;
+
+    ArangoStatistics(ArangoConnection connection) {
+        this.connection = connection;
+    }
+
+    @Override
+    public void connect() {
+        checkNotClosed();
+        connection.open(30, Duration.ofSeconds(2));
+    }
+
+    @Override
+    public long vertexCount() {
+        return count("RETURN LENGTH(vertices)", Map.of());
+    }
+
+    @Override
+    public long edgeCount() {
+        return count("RETURN LENGTH(edges)", Map.of());
+    }
+
+    @Override
+    public long outDegree(String id) {
+        return count("RETURN LENGTH(FOR e IN edges FILTER e._from == @from RETURN 1)",
+                Map.of("from", ArangoDatabase.VERTICES + "/" + id));
+    }
+
+    @Override
+    public void close() {
+        closed = true;
+    }
+
+    private long count(String query, Map<String, Object> bindVars) {
+        checkNotClosed();
+        try (ArangoCursor<Long> cursor = connection.database().query(query, Long.class, bindVars)) {
+            return cursor.next();
+        } catch (IOException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private void checkNotClosed() {
+        if (closed) {
+            throw new IllegalStateException("These ArangoDB statistics are closed");
+        }
+    }
+}
