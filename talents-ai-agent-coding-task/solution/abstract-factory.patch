diff --git a/src/main/java/com/myorg/webservice/graph/arango/ArangoConnection.java b/src/main/java/com/myorg/webservice/graph/arango/ArangoConnection.java
new file mode 100644
index 0000000..7d0f59c
--- /dev/null
+++ b/src/main/java/com/myorg/webservice/graph/arango/ArangoConnection.java
@@ -0,0 +1,173 @@
+package com.myorg.webservice.graph.arango;
+
+import com.arangodb.ArangoDB;
+import com.arangodb.Protocol;
+import java.net.URI;
+import java.time.Duration;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * The single ArangoDB driver connection of an {@link ArangoDatabaseFactory}, shared by all its products, which may use
+ * it from several threads. It is opened by the first product that connects and closed only by the factory.
+ *
+ * <p>The lock of this object guards the state only: it is never held while the server is contacted or between
+ * attempts, so that {@link #close()} never waits for a connect in progress.
+ */
+final class ArangoConnection {
+
+    private static final System.Logger LOG = System.getLogger(ArangoConnection.class.getName());
+
+    private final String url;
+    private final String user;
+    private final String password;
+    private final String databaseName;
+    private ArangoDB arango;
+    private com.arangodb.ArangoDatabase database;
+    private boolean opening;
+    private boolean closed;
+
+    ArangoConnection(String url, String user, String password, String databaseName) {
+        this.url = url;
+        this.user = user;
+        this.password = password;
+        this.databaseName = databaseName;
+    }
+
+    /**
+     * Connects to the server and creates the database if it is missing; does nothing if already connected.
+     * Concurrent calls wait for the one that is connecting instead of opening a driver of their own, and try
+     * themselves only if it fails. Closing the connection stops the attempts, and a driver that connects after the
+     * close is closed again.
+     *
+     * @param attempts number of attempts; the server may still be starting
+     * @param interval pause between attempts
+     * @throws IllegalStateException if the server cannot be reached or the connection is closed
+     */
+    void open(int attempts, Duration interval) {
+        if (!claimOpening()) {
+            return;
+        }
+        ArangoDB candidate = null;
+        try {
+            URI uri = URI.create(url);
+            boolean ssl = "https".equalsIgnoreCase(uri.getScheme());
+            int port = uri.getPort() > 0 ? uri.getPort() : (ssl ? 443 : 8529);
+            candidate = new ArangoDB.Builder()
+                    .host(uri.getHost(), port)
+                    .useSsl(ssl)
+                    .user(user)
+                    .password(password)
+                    .protocol(Protocol.HTTP_JSON)
+                    .build();
+            com.arangodb.ArangoDatabase connected = null;
+            RuntimeException last = null;
+            for (int attempt = 1; attempt <= attempts && connected == null; attempt++) {
+                checkNotClosed();
+                try {
+                    com.arangodb.ArangoDatabase target = candidate.db(databaseName);
+                    if (!target.exists()) {
+                        candidate.createDatabase(databaseName);
+                    }
+                    target.getVersion();
+                    connected = target;
+                } catch (RuntimeException e) {
+                    last = e;
+                    LOG.log(System.Logger.Level.WARNING, "Failed to connect to ArangoDB (attempt {0}): {1}", attempt,
+                            e.getMessage());
+                    pause(interval);
+                }
+            }
+            if (connected == null) {
+                throw new IllegalStateException("Cannot connect to ArangoDB at " + url, last);
+            }
+            publish(candidate, connected);
+            candidate = null;
+            LOG.log(System.Logger.Level.INFO, "Connected to ArangoDB {0}/{1}", url, databaseName);
+        } finally {
+            if (candidate != null) {
+                candidate.shutdown();
+            }
+            finishOpening();
+        }
+    }
+
+    /**
+     * The connected database.
+     *
+     * @throws IllegalStateException if the connection is not open
+     */
+    synchronized com.arangodb.ArangoDatabase database() {
+        checkNotClosed();
+        if (database == null) {
+            throw new IllegalStateException("Not connected to ArangoDB; call connect() first");
+        }
+        return database;
+    }
+
+    synchronized void checkNotClosed() {
+        if (closed) {
+            throw new IllegalStateException("The ArangoDB connection is closed");
+        }
+    }
+
+    synchronized void close() {
+        closed = true;
+        notifyAll();
+        database = null;
+        if (arango != null) {
+            arango.shutdown();
+            arango = null;
+        }
+    }
+
+    /**
+     * Waits until no other thread is connecting.
+     *
+     * @return {@code true} if the caller must connect, {@code false} if the connection is open already
+     */
+    private synchronized boolean claimOpening() {
+        while (true) {
+            checkNotClosed();
+            if (database != null) {
+                return false;
+            }
+            if (!opening) {
+                opening = true;
+                return true;
+            }
+            try {
+                wait();
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                throw new IllegalStateException("Interrupted while waiting for the ArangoDB connection", e);
+            }
+        }
+    }
+
+    /** Keeps the connected driver, unless the connection was closed meanwhile. */
+    private synchronized void publish(ArangoDB connectedDriver, com.arangodb.ArangoDatabase connectedDatabase) {
+        checkNotClosed();
+        arango = connectedDriver;
+        database = connectedDatabase;
+    }
+
+    private synchronized void finishOpening() {
+        opening = false;
+        notifyAll();
+    }
+
+    /** Waits for the pause between attempts, or less if the connection is closed meanwhile. */
+    private synchronized void pause(Duration interval) {
+        long deadline = System.nanoTime() + interval.toNanos();
+        long remaining = interval.toNanos();
+        while (!closed && remaining > 0) {
+            try {
+                TimeUnit.NANOSECONDS.timedWait(this, remaining);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return;
