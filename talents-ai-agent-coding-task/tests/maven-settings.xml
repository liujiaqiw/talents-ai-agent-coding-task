<?xml version="1.0" encoding="UTF-8"?>
<!--
  Empty Maven settings for the verifier's build, passed as both the user and the global settings, so that settings the
  agent could change in the image (~/.m2/settings.xml, the Maven installation's conf/settings.xml) are not used.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
</settings>
